# PhyloBuild: somatic phylogenies from clonal whole-genome sequencing.
#
#   snakemake --profile profiles/sanger-lsf --configfile /path/to/study/config.yaml       # run everything
#   snakemake --profile profiles/sanger-lsf --configfile /path/to/study/config.yaml -n    # dry run
#   snakemake --profile profiles/sanger-lsf /path/to/study/PD12345/qc/sex_check.tsv \
#       --configfile /path/to/study/config.yaml     # run up to one output (output names go before --configfile)
#
# Results go to <study_dir>/<donor>/ for each donor, where study_dir is set in the config.
#
# Steps for each donor (rules/ has one file per stage):
#   staging.smk      (Sanger only, optional) stage BAMs out of iRODS
#   calls.smk        PASS SNVs/indels per sample -> bed files of sites
#   hairpin.smk      LCM hairpin artefact filter per sample
#   cgpvaf.smk       read counts at every site in every sample (batched cgpVAF) -> merged matrices
#   filtering.smk    sex check, filter parameters (with/without upfront colony filtering), hairpin reduction,
#                    sensitivity
#   tree.smk         tree building, one per upfront-colony-filter x filtering-type combination

import copy
import csv
import json
import os
import re
import shlex
import subprocess
import sys

from snakemake.exceptions import WorkflowError

# config/config.yaml unless another config is given with --configfile (which then replaces it rather than being
# merged into it, so a second project's config doesn't pick up this one's donors)
if "donors" not in config:
    configfile: "config/config.yaml"


# ---- Config helpers ----

def deep_merge(base, override):
    out = copy.deepcopy(base)
    for k, v in (override or {}).items():
        out[k] = deep_merge(out[k], v) if isinstance(v, dict) and isinstance(out.get(k), dict) else v
    return out

DONORS = {d: deep_merge(config["defaults"], settings) for d, settings in config["donors"].items()}


# ---- Study directory ----
# Each donor's results go to <study_dir>/<donor>/. The sample sheet (<study_dir>/samples.tsv), staged BAMs
# (<study_dir>/staged_bams) and LSF logs (<study_dir>/logs/lsf) default to the study directory too.

if "outdir" in config and "study_dir" not in config:
    raise ValueError("The config's `outdir` setting has been replaced by `study_dir`: results now go to "
                     "<study_dir>/<donor>/")
STUDY = config.get("study_dir")
if not STUDY or not os.path.isdir(STUDY):
    raise ValueError(f"study_dir must be an existing directory (it is {STUDY!r}). Set it in the config, or add "
                     "--config study_dir=/path/to/study at the end of the snakemake command.")
STUDY = os.path.abspath(STUDY)
OUT = STUDY
config.setdefault("samples", f"{STUDY}/samples.tsv")
#Read by profiles/sanger-lsf/lsf_submit.sh, which the controller runs to submit each job
os.environ["PHYLOBUILD_LSF_LOGS"] = f"{STUDY}/logs/lsf"

def donor_cfg(donor):
    return DONORS[donor]

def cf_label(value):
    """Label for an upfront colony filter value: 'none' or e.g. 'cf0.4'."""
    return "none" if value in (None, "none", "None") else f"cf{value}"


# ---- Sample sheet ----
# If the sample sheet doesn't exist, it is built from nst_links using each donor's `projects` (Sanger only), with a
# first line recording what it was built from. A sheet without that line (made by hand or by another script) is
# used as it is. exclude_samples and exclude_pattern are applied when the sheet is read, so changing them needs
# no rebuild.

BUILT_MARK = "# Built by PhyloBuild from the config: "

def sheet_selection():
    """What a built sheet is made from, per donor (only donors with `projects`)."""
    sel = {}
    for d, cfg in DONORS.items():
        if cfg.get("projects"):
            sel[d] = {"projects": [str(p) for p in cfg["projects"]],
                      "pd_ids": [str(p) for p in (cfg.get("pd_ids") or [d])],
                      "include_samples": sorted(cfg.get("include_samples") or []),
                      "nst_links": cfg.get("nst_links") or "/software/SGP/nst_links/live"}
    return sel

def build_sample_sheet(path):
    sys.path.insert(0, os.path.join(workflow.basedir, "scripts"))
    from sanger_sample_sheet import COLUMNS, find_samples, print_summary
    sel = sheet_selection()
    no_projects = [d for d in DONORS if d not in sel]
    if no_projects:
        raise ValueError(f"There is no sample sheet at {path}, and donor(s) {', '.join(no_projects)} have no "
                         "`projects` in the config to build one from. Add `projects` (and if needed pd_ids, "
                         "include_samples) to each donor, or make the sheet yourself (see GUIDE.md).")
    rows = []
    for d, s in sel.items():
        try:
            r, not_ready, not_found = find_samples(d, s["projects"], pd_ids=s["pd_ids"], include=s["include_samples"],
                                                   nst_links=s["nst_links"])
        except FileNotFoundError as e:
            raise ValueError(f"Building the sample sheet for {d}: {e}")
        print_summary(d, r, not_ready, not_found)
        rows += r
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        fh.write(BUILT_MARK + json.dumps(sel, sort_keys=True) + "\n")
        fh.write("\t".join(COLUMNS) + "\n")
        for r in rows:
            fh.write("\t".join(r[c] for c in COLUMNS) + "\n")
    os.replace(tmp, path)
    print(f"Sample sheet built from nst_links: {path}", file=sys.stderr)

def check_built_sheet(path):
    """Stop if a sheet built by the pipeline no longer matches the donors' projects/pd_ids/include_samples."""
    with open(path) as fh:
        first = fh.readline().rstrip("\n")
    if not first.startswith(BUILT_MARK):
        if sheet_selection():
            print(f"Note: using the sample sheet {path} as it is; the donors' projects/pd_ids/include_samples "
                  "settings are only used to build a sheet when there isn't one", file=sys.stderr)
        return
    if json.loads(first[len(BUILT_MARK):]) != sheet_selection():
        raise ValueError(f"The sample sheet {path} was built from different projects/pd_ids/include_samples than "
                         "the config now has. Delete it to rebuild it from the config (or, if you edited it by hand, "
                         "delete its first line to keep it as it is).")

def read_samples(path):
    with open(path) as fh:
        lines = [l for l in fh if not l.startswith("#")]
    rows = [r for r in csv.DictReader(lines, delimiter="\t") if r["donor"]]
    required = {"donor", "sample", "caveman_vcf", "pindel_vcf"} | ({"project"} if config.get("bam_staging") == "sanger" else {"bam"})
    missing = required - set(rows[0].keys()) if rows else required
    if missing:
        raise ValueError(f"Sample sheet {path} is missing column(s): {', '.join(sorted(missing))}")
    samples = {}
    for r in rows:
        if r["donor"] not in DONORS or r["sample"] in DONORS[r["donor"]]["exclude_samples"]:
            continue
        pattern = DONORS[r["donor"]].get("exclude_pattern")
        if pattern and re.search(pattern, r["sample"]):
            continue
        samples.setdefault(r["donor"], {})[r["sample"]] = r
    for d, cfg in DONORS.items():
        in_sheet = {r["sample"] for r in rows if r["donor"] == d}
        for s in set(cfg["exclude_samples"]) - in_sheet:
            print(f"Note: {s} is in exclude_samples for {d} but not in the sample sheet", file=sys.stderr)
    for d in DONORS:
        if d not in samples:
            raise ValueError(f"Donor {d} is in the config but has no samples in {path}")
    return samples

if os.path.exists(config["samples"]):
    check_built_sheet(config["samples"])
else:
    build_sample_sheet(config["samples"])
SAMPLES = read_samples(config["samples"])

def samples_of(donor):
    return sorted(SAMPLES[donor])

def sample_row(donor, sample):
    return SAMPLES[donor][sample]

def mem_for_samples(donor, base_mb, per_sample_mb, attempt=1):
    """Memory that grows with the number of colonies (e.g. ~300 colonies needed 64 GB for the tree step)."""
    return int(max(base_mb, per_sample_mb * len(samples_of(donor))) * attempt)

def cgpvaf_batches(donor):
    """Samples split into cgpVAF batches, as {batch_number: [samples]}."""
    size = int(donor_cfg(donor)["cgpvaf_batch_size"])
    s = samples_of(donor)
    return {i // size + 1: s[i:i + size] for i in range(0, len(s), size)}


CHROMOSOMES = config["reference"]["chromosomes"]
SCRIPTS = os.path.join(workflow.basedir, "scripts")

wildcard_constraints:
    donor = "|".join(re.escape(d) for d in sorted(DONORS, key=len, reverse=True)),
    vartype = "snv|indel",
    cf = r"none|cf[0-9.]+",
    filtering = "pval|vaf",
    batch = r"\d+",
    chrom = "|".join(re.escape(c) for c in CHROMOSOMES),

def modules(kind):
    return config.get("modules", {}).get(kind, [])


# ---- Start-up check: can the R jobs load the R packages? ----
# Checked as the jobs run R (with the config's R modules, `Rscript --vanilla`), so a missing or misplaced install
# stops the run in seconds instead of at the first R step, after hours of cgpVAF. Not run for dry runs.

R_CHECK = (
    'p = c("phylobuild", "treemut"); '
    'miss = p[!vapply(p, requireNamespace, logical(1), quietly = TRUE)]; '
    'if (!"treemut" %in% miss && packageVersion("treemut") < "1.2") miss = c(miss, "treemut >= 1.2"); '
    'if (length(miss)) { cat("Missing: ", paste(miss, collapse = ", "), "\\nR looked in:\\n  ", paste(.libPaths(), collapse = "\\n  "), "\\n", sep = ""); quit(status = 1) }'
)

def check_r_packages():
    try:
        from snakemake.settings.types import DeploymentMethod
        use_modules = DeploymentMethod.ENV_MODULES in workflow.deployment_settings.deployment_method
    except Exception:
        use_modules = False
    env = dict(os.environ)
    prefix = ""
    if use_modules and modules("r"):
        #outside a login shell the farm's `module` command comes from the profile's modules_init.sh, as in the jobs
        init = os.path.join(workflow.basedir, "..", "profiles", "sanger-lsf", "modules_init.sh")
        if subprocess.run(["bash", "-c", "type module"], capture_output=True).returncode != 0 and os.path.exists(init):
            env["BASH_ENV"] = os.path.abspath(init)
        prefix = "module purge && MODULES_VERBOSITY=concise module load " + " ".join(modules("r")) + "; "
    cmd = prefix + "Rscript --vanilla -e " + shlex.quote(R_CHECK)
    try:
        res = subprocess.run(["bash", "-c", cmd], capture_output=True, text=True, env=env, timeout=300)
    except subprocess.TimeoutExpired:
        print("Note: the R package check timed out; carrying on", file=sys.stderr)
        return
    if res.returncode != 0:
        raise WorkflowError(
            "The R jobs can't load the PhyloBuild R packages:\n" + (res.stdout + res.stderr).strip() + "\n"
            "Install them into your default personal R library, with the same R the jobs use (see the README):\n"
            "  module load " + (" ".join(modules("r")) or "R") + "\n"
            "  Rscript -e 'dir.create(Sys.getenv(\"R_LIBS_USER\"), recursive = TRUE, showWarnings = FALSE)'\n"
            "  Rscript -e 'if (!requireNamespace(\"treemut\", quietly = TRUE) || packageVersion(\"treemut\") < \"1.2\") remotes::install_github(\"nangalialab/treemut\")'\n"
            "  R CMD INSTALL phylobuild   # from the PhyloBuild folder\n"
            "A library set with R_LIBS in .bashrc or in ~/.Renviron isn't seen by the jobs.")

onstart:
    check_r_packages()


# ---- Final targets ----

def tree_targets():
    targets = []
    for d, cfg in DONORS.items():
        targets.append(f"{OUT}/{d}/qc/sex_check.tsv")
        for cf in cfg["upfront_colony_filter"]:
            for filtering in cfg["tree_filtering"]:
                targets.append(f"{OUT}/{d}/trees/{d}_{cf_label(cf)}/tree_files/tree_{d}_{cf_label(cf)}_{filtering}_post_mix_post_dup.tree")
    return targets

rule all:
    input: tree_targets()


include: "rules/staging.smk"
include: "rules/calls.smk"
include: "rules/hairpin.smk"
include: "rules/cgpvaf.smk"
include: "rules/filtering.smk"
include: "rules/tree.smk"
